<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-telc-a1-t2 | TELC A1 #2 | /audio/exams/telc/a1/teil2-durchsagen.mp3 -->
  <voice name="de-DE-AmalaNeural">
    <prosody rate="-12%">Achtung, Fahrgäste nach Frankfurt! Der Reisebus um vierzehn Uhr zwanzig fährt heute ausnahmsweise nicht von Bussteig drei, sondern von Bussteig sieben ab. Bitte gehen Sie direkt zu Bussteig sieben.</prosody>
    <break time="500ms"/>
  </voice>
</speak>
