<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-practice-qb-a2-h-036 | PRACTICE A2 #40 | /audio/practice/a2/qb-a2-h-036.mp3 -->
  <voice name="de-DE-KillianNeural">
    <prosody rate="-6%">Jede Woche werfen viele Haushalte gutes Essen in die Tonne, obwohl man daraus schnell etwas Leckeres zaubern könnte. Ist das Weißbrot vom Wochenende schon etwas trocken? Schneiden Sie es in kleine Würfel und rösten Sie diese mit etwas Knoblauch und Olivenöl in der Pfanne — fertig sind knusprige Croutons für jede Suppe! Aus leicht weichen Tomaten, Paprika und Zwiebeln im Gemüsefach kochen Sie in zwanzig Minuten eine würzige Pastasoße. Und reife Bananen mit braunen Punkten lassen sich prima einfrieren und zu süßem Bananeneis pürieren.</prosody>
  </voice>
</speak>
