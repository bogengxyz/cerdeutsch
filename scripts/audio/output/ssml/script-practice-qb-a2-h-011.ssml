<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-practice-qb-a2-h-011 | PRACTICE A2 #15 | /audio/practice/a2/qb-a2-h-011.mp3 -->
  <voice name="de-DE-KatjaNeural">
    <prosody rate="-6%">Guten Tag! Wohin soll Ihr Sommerurlaub dieses Jahr gehen?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="-6%">Wir möchten im September zehn Tage nach Portugal fliegen, am liebsten an die Algarve. Wichtig sind ein ruhiges Hotel in Strandnähe und Halbpension.</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="-6%">Im September ist das Wetter dort herrlich und nicht mehr so voll wie im August. Ich habe hier das Hotel „Praia Verde“ — nur 200 Meter vom Sandstrand entfernt. Direktflug ab Frankfurt inklusive Transfer zum Hotel und Frühstück sowie Abendessen kostet aktuell 890 Euro pro Person.</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="-6%">Das klingt super! Kann man dort vor Ort auch einen Mietwagen für Ausflüge buchen?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="-6%">Ja, direkt an der Hotelrezeption.</prosody>
  </voice>
</speak>
