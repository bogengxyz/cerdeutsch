  <voice name="de-DE-FlorianMultilingualNeural">
    <prosody rate="-12%">Liebe Reisende, der ICE 512 nach Frankfurt am Main, planmäßige Abfahrt um 08:15 Uhr, fährt heute voraussichtlich erst um 08:35 Uhr auf Gleis 3 ab. Wir bitten um Entschuldigung. Der Bordbistro-Wagen befindet sich heute in der Zugmitte.</prosody>
  </voice>
</speak>
