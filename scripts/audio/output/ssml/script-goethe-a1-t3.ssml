<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-goethe-a1-t3 | GOETHE A1 #3 | /audio/exams/goethe/a1/goethe-a1-teil3-einkaufen.mp3 -->
  <voice name="de-DE-ConradNeural">
    <prosody rate="-12%">Guten Morgen! Was darf es heute sein?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="-12%">Guten Morgen! Ich hätte gern ein Kilo Tomaten und sechs frische Äpfel, bitte.</prosody>
    <break time="650ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="-12%">Sehr gern. Brauchen Sie auch Kartoffeln oder Bananen?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="-12%">Nein, danke. Was kostet alles zusammen?</prosody>
    <break time="650ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="-12%">Das macht zusammen vier Euro fünfzig. Hier bitte, eine Tüte ist gratis dabei.</prosody>
    <break time="500ms"/>
  </voice>
</speak>
