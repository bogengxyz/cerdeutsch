<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-practice-qb-a1-h-009 | PRACTICE A1 #13 | /audio/practice/a1/qb-a1-h-009.mp3 -->
  <voice name="de-DE-ConradNeural">
    <prosody rate="-12%">So, das hier ist das Schlafzimmer mit Blick in den ruhigen Innenhof.</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="-12%">Sehr schön! Und gibt es einen Aufzug im Haus?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="-12%">Nein, leider nicht, aber die Wohnung liegt ja nur im ersten Stock. Ein Kellerraum gehört natürlich auch dazu. Die Heizung funktioniert mit Fernwärme.</prosody>
  </voice>
</speak>
