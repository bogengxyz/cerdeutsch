<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-practice-qb-a2-h-003 | PRACTICE A2 #7 | /audio/practice/a2/qb-a2-h-003.mp3 -->
  <voice name="de-DE-KillianNeural">
    <prosody rate="-6%">Guten Abend Frau Becker! Entschuldigen Sie die späte Störung — hat der Paketbote heute vielleicht ein großes Paket für mich bei Ihnen abgegeben?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-AmalaNeural">
    <prosody rate="-6%">Hallo Jonas! Ja, genau, ein ziemlich schwerer Karton von einem Sportgeschäft liegt in meinem Flur. Ich wollte eigentlich um sechs bei Ihnen klingeln, aber da waren Sie wohl noch beim Training.</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-KillianNeural">
    <prosody rate="-6%">Stimmt, ich hatte heute Basketball bis halb acht. Vielen Dank, dass Sie es angenommen haben!</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-AmalaNeural">
    <prosody rate="-6%">Kein Problem! Warten Sie kurz, ich hole es sofort — allein tragen müssen Sie es aber selbst, das wiegt mindestens zehn Kilo!</prosody>
  </voice>
</speak>
