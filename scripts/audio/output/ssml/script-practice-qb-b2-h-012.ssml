<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-practice-qb-b2-h-012 | PRACTICE B2 #16 | /audio/practice/b2/qb-b2-h-012.mp3 -->
  <voice name="de-DE-ConradNeural">
    <prosody rate="+4%">Unter unseren Straßen fließt jeden Tag eine überraschend konstante Wärmequelle vorbei: Abwasser aus Duschen, Küchenspülen und Waschmaschinen hat selbst im tiefsten Winter noch rund zwölf bis fünfzehn Grad Celsius. In mehreren deutschen Städten nutzen kommunale Werke nun Wärmetauscher direkt in größeren Abwasserkanälen.</prosody>
    <break time="450ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="+4%">Diese Technik entzieht dem Wasser einige Grad Wärme, speist damit hocheffiziente Großwärmepumpen und beheizt ganze Schulzentren oder Schwimmbäder – ganz ohne fossile Brennstoffe. Wichtig ist lediglich eine regelmäßige Reinigung der Metallflächen, damit sich keine Fettablagerungen bilden.</prosody>
  </voice>
</speak>
