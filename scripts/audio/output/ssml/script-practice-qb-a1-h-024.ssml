<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-practice-qb-a1-h-024 | PRACTICE A1 #28 | /audio/practice/a1/qb-a1-h-024.mp3 -->
  <voice name="de-DE-ConradNeural">
    <prosody rate="-12%">Hausmeisterservice Müller, guten Morgen.</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-KillianNeural">
    <prosody rate="-12%">Guten Morgen, hier ist Herr Albers aus Wohnung 14. In meinem Badezimmer tropft der Wasserhahn sehr stark. Wann könnten Sie vorbeikommen?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="-12%">Heute habe ich leider viele Termine, aber morgen früh um 08:30 Uhr bin ich bei Ihnen.</prosody>
  </voice>
</speak>
