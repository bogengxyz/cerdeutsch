<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-practice-qb-a1-h-033 | PRACTICE A1 #37 | /audio/practice/a1/qb-a1-h-033.mp3 -->
  <voice name="de-DE-KatjaNeural">
    <prosody rate="-12%">Oh, dein kleiner Hund ist ja süß! Wie heißt er denn?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="-12%">Er heißt Bello und ist jetzt zwei Jahre alt. Wir gehen jeden Tag dreimal spazieren: morgens vor der Arbeit zwanzig Minuten, nachmittags eine halbe Stunde und abends noch einmal kurz um den Block.</prosody>
  </voice>
</speak>
