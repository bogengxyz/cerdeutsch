<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-telc-b2-t1 | TELC B2 #1 | /audio/exams/telc/b2/teil1-nachrichten.mp3 -->
  <voice name="de-DE-ConradNeural">
    <prosody rate="0%">Nach vierjähriger Bauzeit wird am kommenden Montag die neue Schnellbahnstrecke zwischen beiden Wirtschaftsregionen offiziell in Betrieb genommen. Die reine Fahrzeit sinkt dadurch von bisher fünfundsiebzig Minuten auf künftig vierzig Minuten.</prosody>
    <break time="650ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="0%">Verkehrsverbände erwarten durch die engere Taktung eine deutliche Entlastung der parallelen Autobahn sowie spürbare Impulse für Pendlerinnen.</prosody>
    <break time="500ms"/>
  </voice>
</speak>
