<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-practice-qb-a1-h-018 | PRACTICE A1 #22 | /audio/practice/a1/qb-a1-h-018.mp3 -->
  <voice name="de-DE-ConradNeural">
    <prosody rate="-12%">Ich suche ein Geschenk für meine Tante. Sie reist sehr gern und kocht italienisches Essen.</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="-12%">Wie wäre es mit diesem neuen Kochbuch über Italien für 24 Euro? Oder wir haben einen schönen Reiseführer über Rom für 16 Euro.</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="-12%">Das Kochbuch klingt toll! Können Sie es bitte als Geschenk einpacken?</prosody>
  </voice>
</speak>
