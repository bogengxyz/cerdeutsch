<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-practice-qb-b1-h-001 | PRACTICE B1 #5 | /audio/practice/b1/qb-b1-h-001.mp3 -->
  <voice name="de-DE-KatjaNeural">
    <prosody rate="0%">Guten Tag! Ich mache nächstes Jahr Abitur und interessiere mich für eine Ausbildung im IT-Bereich. Bilden Sie hier Fachinformatikerinnen aus?</prosody>
    <break time="450ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="0%">Hallo! Ja, genau – wir stellen jedes Jahr im September vier Auszubildende für Anwendungsentwicklung ein. Programmierst du denn schon in der Freizeit?</prosody>
    <break time="450ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="0%">Ein wenig, vor allem kleinere Webseiten mit HTML und etwas JavaScript. Braucht man dafür ein sehr gutes Mathezeugnis?</prosody>
    <break time="450ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="0%">Eine solide Drei reicht völlig aus. Viel wichtiger sind uns logisches Denken, Teamgeist und Lust, Neues zu lernen. Wenn du magst, kannst du in den Osterferien zuerst ein einwöchiges Schnupperpraktikum bei uns machen.</prosody>
    <break time="450ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="0%">Oh, das klingt super! Soll ich meine Bewerbung dafür direkt per Post schicken?</prosody>
    <break time="450ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="0%">Am besten einfach als PDF-Datei über unser Online-Portal – Lebenslauf und ein kurzes Anschreiben genügen für das Praktikum.</prosody>
  </voice>
</speak>
