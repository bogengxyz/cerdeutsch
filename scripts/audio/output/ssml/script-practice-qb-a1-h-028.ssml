<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-practice-qb-a1-h-028 | PRACTICE A1 #32 | /audio/practice/a1/qb-a1-h-028.mp3 -->
  <voice name="de-DE-KillianNeural">
    <prosody rate="-12%">Guten Tag, ich möchte heute Nachmittag nach Potsdam fahren. Welches Ticket brauche ich?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-AmalaNeural">
    <prosody rate="-12%">Dafür genügt eine Einzelfahrkarte Berlin ABC für 4 Euro 40. Sie nehmen die S-Bahn S7 ab Gleis 2 direkt bis Potsdam Hauptbahnhof. Die Fahrt dauert ungefähr 38 Minuten.</prosody>
  </voice>
</speak>
