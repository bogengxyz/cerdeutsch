<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-practice-a1-hoeren-2 | PRACTICE A1 #2 | /audio/practice/a1/a1-hoeren-2.mp3 -->
  <voice name="de-DE-AmalaNeural">
    <prosody rate="-12%">Guten Tag! Haben Sie eine Kundenkarte?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-KillianNeural">
    <prosody rate="-12%">Nein, leider nicht.</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-AmalaNeural">
    <prosody rate="-12%">Kein Problem. Das macht zusammen 14 Euro 80. Möchten Sie bar oder mit Karte zahlen?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-KillianNeural">
    <prosody rate="-12%">Mit Karte, bitte.</prosody>
  </voice>
</speak>
