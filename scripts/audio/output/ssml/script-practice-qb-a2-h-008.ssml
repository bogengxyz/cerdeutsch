<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-practice-qb-a2-h-008 | PRACTICE A2 #12 | /audio/practice/a2/qb-a2-h-008.mp3 -->
  <voice name="de-DE-ConradNeural">
    <prosody rate="-6%">Guten Morgen zusammen! Heute möchte ich kurz unsere neue Kollegin Nadia vorstellen, die ab sofort unser Kundenprojekt in München betreut. Nadia hat vorher vier Jahre in einer Marketingagentur in Köln gearbeitet.</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="-6%">Hallo an alle, ich freue mich sehr auf die Zusammenarbeit!</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="-6%">Damit du schnell alle kennst: Links sitzt Markus, er ist für die Grafiken und Webseiten zuständig. Neben ihm sitzt Yasmin — sie kümmert sich um alle Verträge und Rechnungen. Und falls am Laptop etwas nicht funktioniert, hilft dir David in Büro 12 direkt weiter.</prosody>
  </voice>
</speak>
