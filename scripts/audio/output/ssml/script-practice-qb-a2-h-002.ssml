<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-practice-qb-a2-h-002 | PRACTICE A2 #6 | /audio/practice/a2/qb-a2-h-002.mp3 -->
  <voice name="de-DE-ConradNeural">
    <prosody rate="-6%">Liebe Fahrgäste, in wenigen Minuten erreichen wir Würzburg Hauptbahnhof. Wegen eines technischen Defekts an einem Signal haben wir aktuell etwa zwölf Minuten Verspätung. Fahrgäste nach Nürnberg mit dem ICE 621 um 11:40 Uhr erhalten noch ihren Anschluss: Der ICE wartet heute auf Gleis 7 gegenüber. Reisende in Richtung Bamberg nutzen bitte die Regionalbahn RB 53 ab Gleis 3 um 11:55 Uhr. Bitte achten Sie beim Aussteigen auf die Stufe zwischen Zug und Bahnsteig. Auf Wiedersehen!</prosody>
  </voice>
</speak>
