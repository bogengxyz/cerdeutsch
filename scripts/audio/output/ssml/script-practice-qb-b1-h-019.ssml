<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-practice-qb-b1-h-019 | PRACTICE B1 #23 | /audio/practice/b1/qb-b1-h-019.mp3 -->
  <voice name="de-DE-KatjaNeural">
    <prosody rate="0%">Leserservice der „Südwest-Zeitung“, guten Tag! Was kann ich für Sie tun?</prosody>
    <break time="450ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="0%">Guten Tag, mein Name ist Stefan Riedel. Ich bin demnächst für zwei Monate beruflich im Ausland und möchte meine gedruckte Wochenendausgabe abbestellen.</prosody>
    <break time="450ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="0%">Danke für Ihren Anruf, Herr Riedel. Wenn Sie danach wieder weiterlesen möchten, müssen Sie nicht komplett kündigen – Sie können das Papier-Abo kostenlos für bis zu zwölf Wochen pausieren oder für die Reisezeit digital auf das E-Paper umstellen.</prosody>
    <break time="450ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="0%">Ach, das klingt praktisch! Dann würde ich es am liebsten für genau acht Wochen pausieren, ab dem 1. Juni.</prosody>
    <break time="450ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="0%">Sehr gern, ich trage die Lieferpause vom 1. Juni bis zum 26. Juli im System ein. Die Bestätigung geht Ihnen in wenigen Minuten per E-Mail zu.</prosody>
  </voice>
</speak>
