<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-practice-qb-a1-h-011 | PRACTICE A1 #15 | /audio/practice/a1/qb-a1-h-011.mp3 -->
  <voice name="de-DE-SeraphinaMultilingualNeural">
    <prosody rate="-12%">Kann ich Ihnen helfen?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="-12%">Ja, gern! Ich suche einen leichten Sommerrock in Grün oder Beige.</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-SeraphinaMultilingualNeural">
    <prosody rate="-12%">In Grün haben wir dieses Modell für 39 Euro. Welche Größe tragen Sie?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="-12%">Normalerweise Größe 38. Wo kann ich ihn anprobieren?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-SeraphinaMultilingualNeural">
    <prosody rate="-12%">Rechts neben der Kasse sind die Kabinen.</prosody>
  </voice>
</speak>
