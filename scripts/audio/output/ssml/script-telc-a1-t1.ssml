<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-telc-a1-t1 | TELC A1 #1 | /audio/exams/telc/a1/teil1-kurzgespraeche.mp3 -->
  <voice name="de-DE-ConradNeural">
    <prosody rate="-12%">Guten Tag! Was möchten Sie heute essen?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="-12%">Guten Tag! Ich nehme bitte die Gemüsesuppe. Ist die frisch?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="-12%">Ja, heute ganz frisch gekocht. Und was möchten Sie trinken? Kaffee oder Wasser?</prosody>
    <break time="650ms"/>
  </voice>
  <voice name="de-DE-KatjaNeural">
    <prosody rate="-12%">Ein großes Mineralwasser ohne Kohlensäure, bitte.</prosody>
    <break time="500ms"/>
  </voice>
</speak>
