<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-telc-b2-t4 | TELC B2 #4 | /audio/exams/telc/b2/telc-b2-teil4-diskussion.mp3 -->
  <voice name="de-DE-KatjaNeural">
    <prosody rate="0%">Herr Dr. Falk, würde ein komplett kostenloser Stadtverkehr die Straßen spürbar vom Autoverkehr entlasten?</prosody>
    <break time="650ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="0%">Erfahrungen aus anderen europäischen Städten zeigen ein differenziertes Bild: Zwar steigen die Fahrgastzahlen zunächst an, doch viele neue Nutzerinnen wechseln nicht vom Auto um, sondern vom Fahrrad oder Fußweg.</prosody>
    <break time="700ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="0%">Für Autofahrerinnen sind verlässliche Takte im Zehn-Minuten-Rhythmus und gute Anschlüsse am Stadtrand meist weitaus entscheidender als die letzten zwanzig Euro Ticketpreis im Monat.</prosody>
    <break time="500ms"/>
  </voice>
</speak>
