<?xml version="1.0" encoding="UTF-8"?>
<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <!-- script-goethe-b1-t4 | GOETHE B1 #4 | /audio/exams/goethe/b1/goethe-b1-teil4-arbeitsplatz.mp3 -->
  <voice name="de-DE-ConradNeural">
    <prosody rate="0%">Willkommen im Team, Frau Berg! Haben Sie schon alle Zugangsdaten für Ihren Rechner bekommen?</prosody>
    <break time="600ms"/>
  </voice>
  <voice name="de-DE-AmalaNeural">
    <prosody rate="0%">Ja, danke, das hat super geklappt. Eine Frage noch zu unseren Arbeitszeiten: Wie genau funktioniert die Gleitzeit hier?</prosody>
    <break time="650ms"/>
  </voice>
  <voice name="de-DE-ConradNeural">
    <prosody rate="0%">Unsere Kernzeit liegt zwischen neun Uhr dreißig und fünfzehn Uhr – da sollten alle erreichbar sein. Davor und danach teilen Sie sich Ihre Stunden frei ein, solange mittwochs um zehn unser kurzes Teammeeting besucht wird.</prosody>
    <break time="700ms"/>
  </voice>
  <voice name="de-DE-AmalaNeural">
    <prosody rate="0%">Verstanden! Dann starte ich am liebsten schon gegen acht Uhr morgens.</prosody>
    <break time="500ms"/>
  </voice>
</speak>
